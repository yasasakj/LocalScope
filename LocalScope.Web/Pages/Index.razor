@page "/"
@using LocalScope.Web.Services.ApiClient
@using LocalScope.Shared.Contracts
@inject LocalScopeApiClient ApiClient

<PageTitle>LocalScope - Что вокруг меня</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">🌍 LocalScope - Что вокруг меня</h1>

    <div class="row">
        <!-- Блок поиска адреса -->
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">🔍 Шаг 1: Где искать?</h5>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" @bind="searchQuery" @onkeydown="HandleKeyDown" placeholder="Введите адрес...">
                        <button class="btn btn-primary" @onclick="SearchLocation" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Найти адрес
                        </button>
                    </div>
                </div>
            </div>

            @if (geocodeResult != null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">📍 Найденное местоположение</h6>
                        <p class="mb-1"><strong>@geocodeResult.FormattedAddress</strong></p>
                        <small class="text-muted">
                            Координаты: @geocodeResult.Latitude.ToString("F6"), @geocodeResult.Longitude.ToString("F6")
                        </small>
                    </div>
                </div>
            }
        </div></div>
    

        <!-- Блок отображения погоды -->
        <div class="col-md-6">
            @if (weatherData?.Now != null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title">🌤️ Текущая погода</h5>
                            <button class="btn btn-sm btn-outline-warning" 
                                    @onclick="AddLocationToFavorites" 
                                    disabled="@isLoading">
                                ⭐ В избранное
                            </button>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <h2 class="mb-0 me-3">@weatherData.Now.TemperatureCelsius.ToString("F1")°C</h2>
                            <div>
                                <div>Ощущается: @(weatherData.Now.FeelsLikeCelsius?.ToString("F1") ?? "N/A")°C</div>
                                <div class="text-muted">@weatherData.Now.Condition</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <small>💨 Ветер: @weatherData.Now.WindSpeedMps.ToString("F1") м/с</small>
                            </div>
                            <div class="col-6">
                                <small>💧 Влажность: @weatherData.Now.Humidity%</small>
                            </div>
                        </div>
                        @if (weatherData.Now.ComfortScore.HasValue)
                        {
                            <div class="mt-2">
                                <span class="badge bg-@GetComfortBadgeColor(weatherData.Now.ComfortScore.Value)">
                                    @weatherData.Now.ComfortDescription (Оценка: @weatherData.Now.ComfortScore.Value/100)
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    <!-- Блок кастомного поиска мест -->
    @if (geocodeResult != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">🍴 Шаг 2: Что искать рядом?</h5>
                <div class="input-group mb-3">
                    <input type="text" class="form-control" @bind="placeSearchQuery" @onkeydown="HandlePlaceKeyDown" placeholder="Что ищем? (например: пицца, аптека, продукты)...">
                    <button class="btn btn-success" @onclick="SearchCustomPlaces" disabled="@isLoading">
                        Искать заведения
                    </button>
                </div>
                <div class="btn-group" role="group">
                    <button class="btn btn-sm @GetFilterClass("кафе")" @onclick='() => FilterCategory("кафе")'>Кафе</button>
                    <button class="btn btn-sm @GetFilterClass("ресторан")" @onclick='() => FilterCategory("ресторан")'>Рестораны</button>
                    <button class="btn btn-sm @GetFilterClass("аптека")" @onclick='() => FilterCategory("аптека")'>Аптеки</button>
                    <button class="btn btn-sm @GetFilterClass("продукты")" @onclick='() => FilterCategory("продукты")'>Продукты</button>
                </div>
            </div>
        </div>
    }

    <!-- Список найденных заведений -->
    @if (places?.Items != null && places.Items.Any())
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">🗺️ Результаты поиска (найдено: @places.Items.Count)</h5>
                <div class="list-group">
                    @foreach (var place in places.Items.Take(10))
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@place.Name</h6>
                                <small>@place.DistanceMeters.ToString("F0") м</small>
                            </div>
                            <p class="mb-1 small text-muted">@place.Address</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small>
                                    @if (place.Rating.HasValue)
                                    {
                                        <span class="me-2">⭐ @place.Rating.Value.ToString("F1")</span>
                                    }
                                    @if (place.IsOpenNow.HasValue)
                                    {
                                        <span class="badge bg-@(place.IsOpenNow.Value ? "success" : "danger")">
                                            @(place.IsOpenNow.Value ? "Открыто" : "Закрыто")
                                        </span>
                                    }
                                </small>
                                @if (place.Score.HasValue)
                                {
                                    <small class="text-muted">Оценка релевантности: @place.Score.Value.ToString("F0")/100</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (geocodeResult != null && !isLoading)
    {
        <div class="alert alert-info mt-3">Ничего не найдено по запросу "@(string.IsNullOrWhiteSpace(currentCategory) ? "кафе" : currentCategory)". Попробуйте изменить фильтр.</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }
</div>

@code {
    private string searchQuery = "Москва, Красная площадь";
    private string placeSearchQuery = ""; // Новая переменная для ввода пользователя
    private string? currentCategory = "кафе"; // По дефолту выставляем кафе
    private bool isLoading = false;
    private string? errorMessage;

    private GeocodeResponse? geocodeResult;
    private WeatherResponse? weatherData;
    private PlacesNearbyResponse? places;

    private async Task SearchLocation()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return;

        isLoading = true;
        errorMessage = null;
        geocodeResult = null;
        weatherData = null;
        places = null;

        try
        {
            geocodeResult = await ApiClient.GeocodeAsync(searchQuery);

            if (geocodeResult != null)
            {
                // Если строка кастомного поиска пустая, берем дефолтное "кафе"
                var activeSearch = string.IsNullOrWhiteSpace(placeSearchQuery) ? currentCategory : placeSearchQuery;

                await Task.WhenAll(
                    LoadWeather(geocodeResult.Latitude, geocodeResult.Longitude),
                    LoadPlaces(geocodeResult.Latitude, geocodeResult.Longitude, activeSearch)
                );
            }
            else
            {
                errorMessage = "Указанный адрес не найден.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при поиске: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchCustomPlaces()
    {
        if (geocodeResult == null) return;

        isLoading = true;
        // Если пользователь стёр текст, ставим "кафе" по умолчанию
        currentCategory = string.IsNullOrWhiteSpace(placeSearchQuery) ? "кафе" : placeSearchQuery;
        
        await LoadPlaces(geocodeResult.Latitude, geocodeResult.Longitude, currentCategory);
        isLoading = false;
    }

    private async Task LoadWeather(double lat, double lon)
    {
        try
        {
            weatherData = await ApiClient.GetWeatherAsync(lat, lon, 3);
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки погоды: {ex.Message}";
        }
    }

    private async Task LoadPlaces(double lat, double lon, string? category)
    {
        try
        {
            places = await ApiClient.SearchPlacesAsync(lat, lon, category, 1500, 20);
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка поиска мест: {ex.Message}";
        }
    }
    private async Task AddLocationToFavorites()
    {
        if (geocodeResult == null) return;
    
        try
        {
            await ApiClient.AddToFavoritesAsync(new FavoritePlaceRequest
            {
                PlaceId = Guid.NewGuid().ToString(),
                Name = geocodeResult.FormattedAddress ?? "Моё место",
                Address = geocodeResult.FormattedAddress ?? "",
                Latitude = geocodeResult.Latitude,
                Longitude = geocodeResult.Longitude,
                Category = "location"
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка сохранения: {ex.Message}";
        }
    }
    private async Task FilterCategory(string? category)
    {
        currentCategory = category;
        placeSearchQuery = category ?? ""; // Синхронизируем текстовое поле с кнопкой быстрого фильтра
        if (geocodeResult == null) return;

        isLoading = true;
        await LoadPlaces(geocodeResult.Latitude, geocodeResult.Longitude, currentCategory);
        isLoading = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchLocation();
        }
    }

    private async Task HandlePlaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchCustomPlaces();
        }
    }

    private string GetComfortBadgeColor(int score)
    {
        return score switch
        {
            >= 90 => "success",
            >= 70 => "info",
            >= 50 => "warning",
            _ => "danger"
        };
    }

    private string GetFilterClass(string? category)
    {
        return currentCategory == category ? "btn-primary" : "btn-outline-primary";
    }
}
